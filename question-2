import numpy as np
states = ["Sunny", "Cloudy", "Rainy"]
observations = ["Dry", "Humid", "Wet"]
start_probability = np.array([
    0.5, 0.3, 0.2
])
transition_probability = np.array([
    [0.6, 0.3, 0.1],  # Sunny
    [0.3, 0.4, 0.3],  # Cloudy
    [0.1, 0.3, 0.6]   # Rainy
])
emission_probability = np.array([
    [0.7, 0.2, 0.1],  # Sunny
    [0.2, 0.6, 0.2],  # Cloudy
    [0.1, 0.2, 0.7]   # Rainy
])
obs = [0, 1, 2, 2]
n_states = len(states)
n_obs = len(obs)

viterbi = np.zeros((n_states, n_obs))
path = np.zeros((n_states, n_obs), dtype=int)
viterbi[:, 0] = start_probability * emission_probability[:, obs[0]]
for t in range(1, n_obs):
    for s in range(n_states):

        probabilities = (
            viterbi[:, t-1]
            * transition_probability[:, s]
            * emission_probability[s, obs[t]]
        )

        viterbi[s, t] = np.max(probabilities)
        path[s, t] = np.argmax(probabilities)
best_last_state = np.argmax(viterbi[:, -1])
best_path = [best_last_state]

for t in range(n_obs - 1, 0, -1):
    best_path.append(path[best_path[-1], t])

best_path.reverse()
print("Observations:")
print(["Dry", "Humid", "Wet", "Wet"])

print("\nPredicted Hidden Weather States:")

for state in best_path:
    print(states[state])
    print("Damodhar(192525266)")

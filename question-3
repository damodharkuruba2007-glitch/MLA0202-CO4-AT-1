import numpy as np

image = np.array([
    [100, 102, 250],
    [101, 255, 103],
    [98, 100, 105]
])

print("Original Image:")
print(image)
updated_image = image.copy()
rows, cols = image.shape
for i in range(rows):
    for j in range(cols):

        neighbors = []
    
        if i > 0:
            neighbors.append(image[i-1, j])
      
        if i < rows-1:
            neighbors.append(image[i+1, j])
        
        if j > 0:
            neighbors.append(image[i, j-1])
       
        if j < cols-1:
            neighbors.append(image[i, j+1])
        
        average = np.mean(neighbors)
      
        updated_image[i, j] = int(average)

print("\nUpdated Image:")
print(updated_image)
